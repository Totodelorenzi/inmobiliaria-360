# =====================================================================
# inmobiliaria-360: variables de entorno
# Copiá este archivo como .env.local y completá los valores.
# .env.local está ignorado por git: los secretos NUNCA van al repo.
# En Vercel se cargan en Settings → Environment Variables.
# Formato: NOMBRE=valor, sin espacios alrededor del "=" y sin comillas.
# =====================================================================

# --- Supabase: públicas (llegan al navegador) -------------------------
# Project URL. Formato: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (empieza con sb_publishable_) o la anon key legacy.
# Es segura en el navegador: lo que puede hacer lo limita RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase: SECRETA (solo servidor y scripts) ----------------------
# Secret key (empieza con sb_secret_) o la service_role key legacy.
# Saltea RLS: jamás en código de cliente ni con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Supabase CLI (solo migraciones y scripts locales) ----------------
# Project ref: el <project-ref> de la URL de arriba.
SUPABASE_PROJECT_REF=
# Contraseña de la base que elegiste al crear el proyecto.
SUPABASE_DB_PASSWORD=

# --- Sitio -------------------------------------------------------------
# URL del deploy, sin barra final. En local: http://localhost:3000
# En Vercel es opcional: si falta se usa la URL de producción del proyecto.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Plataforma multi-inmobiliaria ---------------------------------------
# Dominio propio de la plataforma (ej. inmo360.com.ar), sin https://. Con él:
#   panel en app.<dominio>, web de cada inmobiliaria en <subdominio>.<dominio>.
# Vacío: la URL del deploy sirve de panel y las webs se prueban con ?agencia=<subdominio>.
DOMINIO_BASE=
# Opcional: para que la plataforma agregue sola los dominios propios al proyecto de Vercel.
# Token en vercel.com → Account Settings → Tokens. IDs en Project Settings → General.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# --- Admin inicial (solo scripts/create-admin.ts) ---------------------
ADMIN_EMAIL=
# Si está vacía, el script genera una contraseña segura y la guarda acá.
ADMIN_PASSWORD=
