{
  "name": "inmobiliaria-360",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "node --import ./scripts/alias.ts --test \"tests/unit/**/*.test.ts\"",
    "test:db": "node --import ./scripts/alias.ts --test \"tests/db/**/*.test.ts\"",
    "test": "npm run test:unit && npm run test:db",
    "seed": "node --env-file-if-exists=.env.local --import ./scripts/alias.ts scripts/seed.ts",
    "crear-admin": "node --env-file-if-exists=.env.local --import ./scripts/alias.ts scripts/create-admin.ts",
    "test:e2e": "node --env-file=tests/e2e/.env node_modules/@playwright/test/cli.js test",
    "e2e:instalar": "node --env-file=tests/e2e/.env node_modules/@playwright/test/cli.js install chromium webkit"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "heic-to": "^1.5.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "pannellum": "2.5.7",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": "24.x"
  }
}
